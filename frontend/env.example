# AQRYO Frontend Environment Example
#
# IMPORTANT:
# Only PUBLIC values belong in VITE_* variables.
# Never put server secrets in VITE_*.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_APP_URL=https://aqryo.com

# Optional future public IDs only:
# VITE_SENTRY_DSN=
# VITE_GOOGLE_ANALYTICS_ID=
#
# NEVER:
# VITE_OPENAI_API_KEY
# VITE_SUPABASE_SERVICE_ROLE_KEY
# VITE_SIPAY_SECRET
# VITE_SMTP_PASSWORD
